# LLM-провайдер по умолчанию — Polza AI (config.yaml → llm.provider: polza)
POLZA_AI_API_KEY=

# Прямой GigaChat (llm.provider: gigachat). Authorization key = base64 от "ClientID:ClientSecret";
# можно положить и сырую пару "ClientID:ClientSecret" — код сам закодирует её в base64.
GIGACHAT_CREDENTIALS=
GIGACHAT_SCOPE=GIGACHAT_API_PERS
